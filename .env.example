# Postgres (docker-compose.yml publishes it on host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/realestate

# API
PORT=3001
CORS_ORIGINS=http://localhost:3000
# Shared secret for /admin; generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string
# Shared secret between the Next.js server and this API (optional, min 32 chars;
# generate with: openssl rand -hex 32). When a request carries it in
# `x-internal-key`, the rate limiter counts the visitor IP forwarded in
# `x-client-ip` instead of the web server's address. Set the same value in the
# web app (see the Web section). Without it every server-rendered page view shares one budget.
INTERNAL_API_KEY=
# Rate limit per client IP: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Stricter budget for POST /api/chat (every request costs LLM tokens), per client IP
CHAT_THROTTLE_LIMIT=10
# Budget for POST /api/chat across ALL visitors per minute, whatever their IP.
# Caps LLM spend even if requests look like they come from many addresses; over
# it the API answers 429 "The assistant is busy, please try again in a minute."
CHAT_GLOBAL_LIMIT_PER_MINUTE=30

# LLM provider: claude | openai-compatible. Without the selected provider's
# variables the app still boots; POST /api/chat answers 503.
LLM_PROVIDER=claude
# How structured output is requested: functionCalling (default) | jsonSchema
LLM_STRUCTURED_METHOD=functionCalling

# claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# openai-compatible: all three are required (any non-empty key works for Ollama).
# Free option: Google Gemini (key from https://aistudio.google.com/apikey)
#   OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_COMPAT_MODEL=gemini-3.8-flash
# Fallback: Groq
#   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gemini-3.8-flash

# Embeddings (local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Optional LangSmith tracing
# LangChain reads these straight from the environment; no code changes needed.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=real-estate-agent

# Web
# Server-side API base URL (admin server actions); falls back to NEXT_PUBLIC_API_URL
API_URL=http://localhost:3001/api
# INTERNAL_API_KEY (above) must also be set, with the same value, in the web
# server's environment (server-side only, never NEXT_PUBLIC_). The public API
# client then sends it with the visitor's IP so rate limits are per visitor.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Number of reverse proxies YOU run between the internet and the Next.js server
# (nginx = 1, CDN + nginx = 2). The visitor IP for rate limiting is read from the
# RIGHT of x-forwarded-for, skipping this many trusted entries; the left side is
# chosen by the visitor and is never trusted. 0 (default) = no trusted proxy: no
# IP is forwarded and all visitors share the web server's rate-limit budget.
# Set it to the real hop count in production; see README "Deployment notes".
TRUSTED_PROXY_HOPS=0

