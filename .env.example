# Postgres (docker-compose.yml publishes it on host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/realestate

# API (serves the web app and /api on one origin; there is no CORS setup)
NODE_ENV=development
PORT=3001
# Shared secret for /admin, at least 32 characters; generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string
# Number of reverse proxies in front of the API. Leave 0 when the API is reached
# directly. Behind nginx or another reverse proxy set it to 1, so rate limits
# count each visitor by the client IP in X-Forwarded-For instead of the proxy's.
TRUSTED_PROXY_HOPS=0
# Directory of the built web app; blank means apps/web/dist
WEB_DIST_DIR=

# Rate limits: every request, POST /api/chat per IP, POST /api/chat across all visitors
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
CHAT_THROTTLE_LIMIT=10
CHAT_GLOBAL_LIMIT_PER_MINUTE=30
# Upper bound of one chat turn in ms; free-tier Gemini can need 30-50 s for a search turn
CHAT_TURN_TIMEOUT_MS=90000
# Business time zone (IANA name) for "today", "tomorrow" and viewing hours
APP_TIMEZONE=Africa/Cairo

# LLM provider: claude | openai-compatible
LLM_PROVIDER=claude

# claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# openai-compatible (Ollama, free tiers, any /v1 endpoint)
OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gemini-3.5-flash-lite
# How structured output is requested: functionCalling | jsonSchema
LLM_STRUCTURED_METHOD=functionCalling
# Fail fast on a slow or overloaded provider: retries per LLM call, and the
# timeout in ms of one call (a busy provider ends the turn as provider_busy)
LLM_MAX_RETRIES=1
LLM_CALL_TIMEOUT_MS=30000

# Embeddings (local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=real-estate-agent
