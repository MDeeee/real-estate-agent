{
  "name": "real-estate-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI real-estate agent for the Egyptian market: LangGraph chat next to a regular filter search over the same listings.",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "start": "pnpm --filter api start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:create": "pnpm --filter api db:migrate:create",
    "seed": "pnpm --filter api seed",
    "eval": "pnpm --filter api eval",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
